{
  "name": "ens-agent-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Which AI Should Answer This? — specialist agent endpoints and their ENS self-descriptions",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "agent:contract": "tsx agents/contract-helper.ts",
    "agent:copy": "tsx agents/copy-helper.ts",
    "agent:invoice": "tsx agents/invoice-helper.ts",
    "agents": "tsx scripts/run-all-agents.ts",
    "seed": "tsx scripts/seed-agents.ts",
    "verify": "tsx scripts/verify-agents.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.12",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.9"
  }
}
