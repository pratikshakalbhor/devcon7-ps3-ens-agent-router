# ens-agent-router — example configuration.
# Copy to `.env` and fill in. `.env` is gitignored — never commit a real key.
# lib/env.ts loads this file automatically; no dotenv dependency needed.
# ===========================================================================

# ---------------------------------------------------------------------------
# Sepolia — required for `npm run seed` and `npm run verify`
# ---------------------------------------------------------------------------
# Any Sepolia JSON-RPC endpoint. Reads work on the public endpoint; sending
# transactions also needs PRIVATE_KEY with test ETH (faucet: sepoliafaucet.com).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The parent ENS name the three agent subnames live under, e.g.
#     priya-studio-yourname.eth
# You must own it with PRIVATE_KEY. Subnames cost gas only — no registration
# premium. Get one at https://sepolia.ens.domains (testnet mode mints for free).
AGENT_PARENT_NAME=

# Deployer key for `npm run seed`. 32-byte hex, 0x-prefixed.
# Never use a key that holds mainnet funds. Leave empty for --dry-run.
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# What to write into `agent.dev.endpoint`
# ---------------------------------------------------------------------------
# Resolution order (first match wins) — see lib/agent-endpoint.ts:
#
#   1. CONTRACT_HELPER_ENDPOINT / COPY_HELPER_ENDPOINT / INVOICE_HELPER_ENDPOINT
#      Full URL including the path. Each agent listens on its own port, so each
#      needs its own tunnel when you test end-to-end from another machine.
#
#   2. AGENT_PUBLIC_BASE_URL — one shared origin, `/ask` appended. Use this when
#      a reverse proxy routes on path so one URL reaches all three agents.
#
#   3. http://127.0.0.1:<port>/ask — the localhost fallback.
#
CONTRACT_HELPER_ENDPOINT=
COPY_HELPER_ENDPOINT=
INVOICE_HELPER_ENDPOINT=

# Shared origin for all three, e.g. https://agents.example.com
AGENT_PUBLIC_BASE_URL=

# --- Explicit localhost dev exception ---------------------------------------
# The endpoint record must be https:// in production. Setting this to 1 permits
# http:// on loopback hosts only (localhost, 127.0.0.1, [::1]) so you can run
# everything locally without a tunnel. Default 0 = HTTPS required, no exception.
# A plain-http URL on a PUBLIC host is rejected either way.
ALLOW_LOCALHOST_ENDPOINT=0

# ---------------------------------------------------------------------------
# Agent ports and bind address
# ---------------------------------------------------------------------------
CONTRACT_HELPER_PORT=4001
COPY_HELPER_PORT=4002
INVOICE_HELPER_PORT=4003
# 127.0.0.1 is loopback-only. Use 0.0.0.0 only inside a container or when a
# tunnel needs to reach the agent from another interface.
AGENT_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Model endpoint — shared by all three agents (lib/llm-config.ts)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. The default targets a local
# Ollama server, the only endpoint that needs no API key.
LLM_BASE_URL=http://localhost:11434/v1
# Leave empty to send no Authorization header at all.
LLM_API_KEY=
# Any model id the endpoint serves.
LLM_MODEL=llama3.2
# Hard ceiling on one request. The client aborts rather than hanging, and does
# not retry a timeout.
LLM_TIMEOUT_MS=120000
# Retries apply to 429 and 5xx only, with exponential backoff. 0 disables them.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_MS=500
# Ceiling for a single wait, including one derived from a Retry-After header.
LLM_MAX_RETRY_DELAY_MS=8000

# ---------------------------------------------------------------------------
# Seed behaviour
# ---------------------------------------------------------------------------
# Set to 1 to print the plan without sending any transaction.
SEED_DRY_RUN=0
